{
    "name": "@burgwiss/ui",
    "version": "0.2.2",
    "description": "Burgwiss design system \u2014 tokens, atoms, molecules, organisms, templates.",
    "private": true,
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css",
        "./theme.css": "./dist/tokens/theme.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "storybook dev -p 6006",
        "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
        "prepare": "npm run build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "vitest run --project=unit",
        "test:watch": "vitest",
        "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run storybook:build",
        "storybook:build": "storybook build -o storybook-static",
        "storybook:publish": "bash deploy/publish-storybook.sh",
        "themes:sync": "node scripts/sync-themes.mjs",
        "test:browser": "vitest run --project=storybook --project=browser",
        "check:full": "npm run check && npm run test:browser"
    },
    "peerDependencies": {
        "@headlessui/react": "^2.2.0",
        "cmdk": "^1.1.1",
        "lucide-react": ">=1.0.0",
        "radix-ui": "^1.6.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwindcss": "^4.0.0",
        "@tanstack/react-virtual": "^3.13.0"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/public-sans": "^5.3.0",
        "@fontsource/source-serif-4": "^5.3.0",
        "@headlessui/react": "^2.2.10",
        "@storybook/addon-a11y": "^10.6.1",
        "@storybook/addon-docs": "^10.6.1",
        "@storybook/addon-links": "^10.6.1",
        "@storybook/addon-mcp": "^10.6.1",
        "@storybook/addon-vitest": "^10.6.1",
        "@storybook/react-vite": "^10.6.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-virtual": "^3.14.13",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest-axe": "^3.5.9",
        "@types/node": "^24.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.0.0",
        "@vitest/browser-playwright": "^4.1.11",
        "@vitest/coverage-v8": "^4.1.11",
        "cmdk": "^1.1.1",
        "eslint": "^9.39.4",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-storybook": "^10.4.6",
        "globals": "^16.0.0",
        "jest-axe": "^10.0.0",
        "jsdom": "^29.1.1",
        "lucide-react": "^1.16.0",
        "playwright": "^1.63.0",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.7.0",
        "radix-ui": "^1.6.7",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "storybook": "^10.6.1",
        "storybook-addon-tag-badges": "^3.1.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.59.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.6"
    }
}
